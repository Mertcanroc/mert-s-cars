{% extends 'base.html.twig' %}

{% block title %}Nieuwsbrief versturen{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Nieuwsbrief versturen</h1>

        <div class="card bg-dark text-light p-4">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.subject) }}
                {{ form_widget(form.subject, { attr: { class: 'form-control bg-dark text-light border-secondary' } }) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.content) }}
                {{ form_widget(form.content, { attr: { class: 'form-control bg-dark text-light border-secondary', rows: 10 } }) }}
            </div>

            <button class="btn btn-primary">Versturen</button>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
