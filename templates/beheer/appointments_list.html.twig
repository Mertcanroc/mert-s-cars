{% extends 'base.html.twig' %}
{% block title %}Afspraak beheer{% endblock %}

{% block body %}
{% for appointment in appointments %}
    <div>
        <strong>{{ appointment.user.email }}</strong> - {{ appointment.appointmentType }} op {{ appointment.startTime|date('d-m-Y H:i') }}
        <a href="{{ path('appointment_approve', {id: appointment.id}) }}">Goedkeuren</a>
        <a href="{{ path('appointment_reject', {id: appointment.id}) }}">Afwijzen</a>
    </div>
{% else %}
    <p>Geen openstaande afspraken.</p>
{% endfor %}
<a href="{{ path('app_appointment_book') }}" class="btn bg-success mt-5">Terug naar afspraken</a>
{% endblock %}

