{% extends 'base.html.twig' %}

{% block title %}Beheer Proefritten{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Proefrittenbeheer</h1>

        <table class="table table-bordered table-dark">
            <thead>
            <tr>
                <th>ID</th>
                <th>Gebruiker</th>
                <th>Auto</th>
                <th>Datum</th>
                <th>Tijd</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            {% for drive in testDrives %}
                <tr>
                    <td>{{ drive.id }}</td>
                    <td>{{ drive.user ? drive.user.email : 'Onbekend' }}</td>
                    <td>{{ drive.car ? drive.car.model : 'Onbekend' }}</td>
                    <td>{{ drive.date|date('Y-m-d') }}</td>
                    <td>{{ drive.time|date('H:i') }}</td>
                    <td>{{ drive.status }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Geen proefritten gevonden.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <p>Approve/deny via database</p>
    </div>
{% endblock %}
