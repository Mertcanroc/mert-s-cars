<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}
        <!-- Bootstrap Bundle JS (includes Popper) -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}
{% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
    <style>
        @keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        .navbar {
            animation: fadeIn 1.2s ease-in-out forwards;
            opacity: 0;
            animation-delay: 0.1s;
        }

            body {
                background-color: #111;
                color: #fff;
                font-family: Arial, sans-serif;
                background-image: url("{{ asset('images/bgwallpaper.jpg') }}");
            }
            .btn {
                background-color: #9c47ea;
                color: #F5F5F5;
            }
        .newsletter-link {
            color: #9c47ea;
            text-decoration: underline;
            transition: color 0.3s ease;
        }

        .newsletter-link:hover {
            color: darkmagenta;
        }
    </style>
    <div class="navbar">
        <div class="logo">
            <a href="{{ path('app_home') }}">
            <img src="{{ asset('images/bmw-logo.png') }}" alt="BMW Logo">
            </a>
        </div>
        <nav>
            {% if is_granted('ROLE_MEDEWERKER') %}
                <a href="{{ path('app_contact_requests') }}">Contactaanvragen</a>
            {% endif %}
            {% if is_granted('ROLE_BEHEERDER') %}
                <a href="{{ path('beheer_user_list') }}">Gebruikersbeheer</a>
            {% endif %}
            {% if is_granted('ROLE_BEHEERDER') %}
                <a class="nav-link" href="{{ path('beheer_newsletter_send') }}">Nieuwsbrief versturen</a>
            {% endif %}
            <a href="{{ path('app_car_index') }}">Modellen</a>
            <a href=" {{ path('app_contact') }}">Contact</a>
            <a href="{{ path('app_helpbot') }}">BMW Helpbot</a>
            <a href="{{ path('app_appointment_book') }}">Boek een afspraak</a>

            {% if app.user %}
                <span class="text-info">Ingelogd als: {{ app.user.email }}</span>
                <a href="{{ path('app_logout') }}" class="btn">Uitloggen</a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn">Aanmelden</a>
                <a href="{{ path('app_login') }}" class="btn">Inloggen</a>
            {% endif %}
        </nav>
    </div>

    <footer class="footer">
        <p>ROC Mondriaan Brasserskade  |  Mertscars@gmail.com  |  +31 6 15838335</p>
        <div class="newsletter-box">
            <h5>
                <a href="{{ path('newsletter_subscribe') }}" class="newsletter-link">
                    Schrijf je in voor onze nieuwsbrief
                </a>
            </h5>
        </div>
        <small>© 2025 BMW Nederland B.V. Alle rechten voorbehouden. (colofon)</small>
    </footer>
        {% block body %}

        {% endblock %}
    </body>
</html>
