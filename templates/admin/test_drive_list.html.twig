{% extends 'base.html.twig' %}

{% block title %}Admin Test Drives{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Test Drives Admin</h1>

        <table class="table table-bordered table-dark">
            <thead>
            <tr>
                <th>ID</th>
                <th>User</th>
                <th>Car</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            {% for drive in testDrives %}
                <tr>
                    <td>{{ drive.id }}</td>
                    <td>{{ drive.user ? drive.user.email : 'Unknown' }}</td>
                    <td>{{ drive.car ? drive.car.model : 'Unknown' }}</td>
                    <td>{{ drive.date|date('Y-m-d') }}</td>
                    <td>{{ drive.time|date('H:i') }}</td>
                    <td>{{ drive.status }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No test drives found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <p>Approve/deny via the database.</p>
    </div>
{% endblock %}
