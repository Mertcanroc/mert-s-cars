{% extends 'base.html.twig' %}

{% block title %}User Admin{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>User Admin</h1>

        <table class="table table-bordered table-dark">
            <thead>
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Current Role</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles[0] }}</td>
                    <td>

                        <form method="post" action="{{ path('admin_user_change_role', {id: user.id}) }}" style="display:inline-block;">
                            <select name="role" class="form-select form-select-sm d-inline w-auto">
                                <option value="ROLE_ADMIN" {{ user.roles[0] == 'ROLE_ADMIN' ? 'selected' : '' }}>ADMIN</option>
                                <option value="ROLE_EMPLOYEE" {{ user.roles[0] == 'ROLE_EMPLOYEE' ? 'selected' : '' }}>EMPLOYEE</option>
                                <option value="ROLE_CUSTOMER" {{ user.roles[0] == 'ROLE_CUSTOMER' ? 'selected' : '' }}>CUSTOMER</option>
                            </select>
                            <button class="btn btn-sm btn-primary">Save</button>
                        </form>

                        <form method="post" action="{{ path('admin_user_delete', { id: user.id }) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                            <button class="btn btn-sm btn-danger">Delete</button>
                        </form>

                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4">No users found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
