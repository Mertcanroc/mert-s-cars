{% extends 'base.html.twig' %}

{% block title %}BMW Helpbot{% endblock %}

{% block stylesheets %}
    <style>
        body {
            background-color: #000;
            color: white;
            font-family: Arial, sans-serif;
        }

        .helpbot-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #111;
            padding: 20px;
            border-radius: 14px;
            border: 2px solid #9c47ea;
        }

        .helpbot-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid #444;
            padding-bottom: 10px;
        }

        .helpbot-header img {
            width: 32px;
            margin-right: 10px;
        }

        .helpbot-header h2 {
            font-size: 22px;
            margin: 0;
        }

        .chat-bubble {
            background-color: #222;
            border-radius: 16px;
            padding: 14px 18px;
            margin-bottom: 16px;
            border: 1px solid #444;
            line-height: 1.5;
        }

        .chat-bubble strong {
            display: block;
            margin-bottom: 4px;
        }

        .form-wrapper {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .form-wrapper textarea {
            flex: 1;
            background-color: #1c1c1c;
            color: white;
            border: 1px solid #555;
            padding: 10px;
            border-radius: 16px;
            resize: none;
        }

        .form-wrapper button {
            background-color: #9c47ea;
            border: none;
            color: white;
            padding: 12px 18px;
            border-radius: 16px;
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="helpbot-container">
        <div class="helpbot-header">
            <img src="{{ asset('images/helpbot-icon.png') }}" alt="Bot Icon">
            <h2>BMW helpbot</h2>
        </div>

        {% for msg in messages %}
            <div class="chat-bubble">
                <strong>🧑 Jij:</strong> {{ msg.message }}<br>
                <strong>🤖 BMW bot:</strong> {{ msg.botResponse|raw }}
            </div>
        {% else %}
            <p style="text-align:center;">Stel je eerste vraag aan de bot hieronder.</p>
        {% endfor %}

        <div class="form-wrapper">
            {{ form_start(form) }}
            {{ form_widget(form.message) }}
            <button type="submit">Versturen</button>
            {{ form_end(form) }}
        </div>
    </div>
    <script>
        window.addEventListener('beforeunload', function () {
            navigator.sendBeacon('{{ path('helpbot_clear') }}');
        });
    </script>

{% endblock %}
