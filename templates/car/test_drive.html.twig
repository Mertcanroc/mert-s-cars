{% extends 'base.html.twig' %}

{% block title %}Request a Test Drive{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Schedule a test drive with {{ car.model }}</h1>

        {{ form_start(form) }}
        {{ form_row(form.date) }}
        {{ form_row(form.time) }}
        <button class="btn btn-primary mb-3 mt-3">Submit</button>
        {{ form_end(form) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_test_drive_list') }}" class="btn btn-sm bg-success">Manage Test Drives</a>
        {% endif %}

        <h2>Important Information</h2>
        <p>Our garage is available from Monday to Friday, 10:00–18:00. Please schedule your test drive within these hours.</p>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">

    <script>
        $(function () {
            $('input[type="date"]').datepicker({
                dateFormat: 'yy-mm-dd',
                minDate: 0,
                beforeShowDay: $.datepicker.noWeekends
            });
        });
    </script>
{% endblock %}
