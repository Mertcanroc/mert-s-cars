{% extends 'base.html.twig' %}

{% block title %}Our Models{% endblock %}

{% block stylesheets %}
    <style>
        .catalog-header {
            text-align: center;
            padding: 20px 0;
        }
        .filter-buttons {
            text-align: center;
            margin-bottom: 20px;
        }
        .filter-buttons button {
            background-color: #333;
            color: #fff;
            border: 1px solid #888;
            padding: 10px 20px;
            margin: 0 10px;
            cursor: pointer;
        }
        .filter-buttons button:hover {
            background-color: #555;
        }
        .car-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            padding: 20px;
            max-width: 1000px;
            margin: 0 auto;
        }
        .car-card {
            background-color: #222;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
        }
        .car-card img {
            width: 100%;
            max-height: 100px;
            object-fit: contain;
            margin-bottom: 10px;
        }
        footer {
            text-align: center;
            padding: 20px;
            font-size: 14px;
            color: #aaa;
            border-top: 1px solid #333;
            margin-top: 40px;
        }
        .narrow-button {
            width: auto;
            padding: 10px 15px;
        }
    </style>
{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN') %}
        <div style="text-align: center; margin: 20px 0;">
            <a href="{{ path('app_car_new') }}" class="btn bg-success" style="background:#28a745; color:white; padding:10px 20px; text-decoration:none; border-radius:5px;">
                ➕ Add New Car
            </a>
        </div>
    {% endif %}

    <div class="catalog-header">
        <h1>Our Models</h1>
        <p>Explore our wide range of brands and models to find the one that suits you best.</p>
    </div>

    <div class="filter-buttons">
        <a href="{{ path('app_car_index') }}"><button{% if not activeFilter %} style="background-color:#555;"{% endif %}>All Models</button></a>
        <a href="{{ path('app_car_index', {'category': 'BMW'}) }}"><button{% if activeFilter == 'BMW' %} style="background-color:#555;"{% endif %}>BMW</button></a>
        <a href="{{ path('app_car_index', {'category': 'BMW I'}) }}"><button{% if activeFilter == 'BMW I' %} style="background-color:#555;"{% endif %}>BMW I</button></a>
        <a href="{{ path('app_car_index', {'category': 'BMW M'}) }}"><button{% if activeFilter == 'BMW M' %} style="background-color:#555;"{% endif %}>BMW M</button></a>
    </div>

    <div class="car-grid mb-5">
        {% for car in cars %}
            <div class="car-card">
                {% if car.image %}
                    <img src="{{ asset('uploads/' ~ car.image) }}" alt="{{ car.model }}">
                {% else %}
                    <img src="{{ asset('images/default-car.png') }}" alt="No Image">
                {% endif %}
                <h3>{{ car.model }}</h3>
                <h6> From € {{ car.price }}</h6>
                <p class="text-info"> Stock: {{ car.stock }}</p>
                <p style="font-size: 0.9em; color: #bbb;">
                    {% if car.categories|length > 0 %}
                        {{ car.categories[0].name }}
                    {% else %}
                        No Category
                    {% endif %}
                </p>
                <a href="{{ path('app_car_show', {'id': car.id}) }}" class="btn" style="background:#007bff; color:white; padding:6px 15px; margin-top:10px; display:inline-block;">
                    Buy
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_car_edit', {'id': car.id}) }}" class="btn bg-success narrow-button text-white">✏️ Edit</a>
                    {{ include('car/_delete_form.html.twig') }}
                {% endif %}
            </div>
        {% else %}
            <p style="text-align: center;">No models available yet.</p>
        {% endfor %}
    </div>

    <footer>
    </footer>
{% endblock %}
