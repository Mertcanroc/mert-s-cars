{% extends 'base.html.twig' %}

{% block title %}{{ car.model }}{% endblock %}

{% block body %}
    <div style="max-width: 800px; margin: 0 auto; padding: 20px; color: white;">
        <h1>{{ car.model }}</h1>

        {% if car.image %}
            <img src="{{ asset('uploads/' ~ car.image) }}" alt="{{ car.model }}" style="max-width:100%; margin-bottom: 20px;">
        {% endif %}

        <p><strong>Prijs:</strong> €{{ car.price }}</p>
        <p><strong>Voorraad:</strong> {{ car.stock }}</p>
        <p><strong>Categorie:</strong> {{ car.category.name }}</p>
        <p><strong>Beschrijving:</strong><br>{{ car.description|nl2br }}</p>

        <a href="{{ path('app_car_index') }}" class="btn" style="margin-top: 20px; background:#6c757d; color:white; padding:8px 16px;">⬅️ Terug naar overzicht</a>
    </div>
{% endblock %}
