{% extends 'base.html.twig' %}

{% block title %}Welkom bij Mert's BMW's{% endblock %}

{% block body %}
    <style>

        body {
            margin: 0;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-image: url("{{ asset('images/bmw-wallpaper.webp') }}");
            background-size: cover;
            background-position: center;
            color: white;
        }
        @keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            0% {
                opacity: 0;
            }
            100% {
                opacity: 1;
            }
        }

        /* Apply to banner elements */
        .main-banner h1,
        .main-banner p,
        .main-banner .btn {
            animation: fadeInUp 1s ease forwards;
            opacity: 0;
        }

        .main-banner h1 {
            animation-delay: 0.2s;
        }

        .main-banner p {
            animation-delay: 0.5s;
        }

        .main-banner .btn {
            animation-delay: 0.8s;
        }



        /* Footer fade-in */
        .footer {
            animation: fadeIn 1.5s ease-in-out forwards;
            opacity: 0;
            animation-delay: 1s;
        }

        .btn:hover {
            background-color: #9c47ea;
        }

    </style>





    <div class="main-banner text-light">
        <h1>Welkom bij Mert's BMW's</h1>
        <p class="mt-5">Ontdek de ultieme rijervaring met onze topklasse BMW's – zorgvuldig geselecteerd voor de echte liefhebber.</p>
        <a href="#" class="btn">Bekijk onze sportiefste modellen</a>
    </div>

    <footer class="footer">
        <p>Bedrijfslocatie op map | Mail | Telefoonnummer</p>
        <a href="#">Schrijf je in voor onze nieuwsbrief</a><br>
        <small>© 2025 BMW Nederland B.V. Alle rechten voorbehouden. (colofon)</small>
    </footer>
{% endblock %}
