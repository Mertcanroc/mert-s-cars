{% extends 'base.html.twig' %}

{% block title %}Book Appointment{% endblock %}

{% block body %}
    <style>
        .btn {
            background-color: #9c47ea;
        }
    </style>

    <div class="container my-5">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <h1 class="mb-4">Book an Appointment</h1>

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

        <div class="mb-3">
            {{ form_label(form.appointmentType, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.appointmentType, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.appointmentType) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.date, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.date, {'attr': {'class': 'form-control js-datepicker'}}) }}
            {{ form_errors(form.date) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.startTime, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.startTime, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.startTime) }}
        </div>

        <button type="submit" class="btn btn-primary">Book Appointment</button>
        <a href="{{ path('app_appointment_schedule') }}" class="btn btn-secondary ms-2">View Schedule</a>

        {{ form_end(form) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_appointments_list') }}" class="btn bg-success mt-5" style="margin-right: 500px">Manage Appointments</a>
        {% endif %}
    </div>

    {# Optional datepicker (use only if you want jQuery UI) #}
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        $(function () {
            $('.js-datepicker').datepicker({
                dateFormat: 'yy-mm-dd',
                minDate: 0,
                beforeShowDay: $.datepicker.noWeekends,
            });
        });
    </script>
{% endblock %}
