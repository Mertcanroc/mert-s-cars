{% extends 'base.html.twig' %}

{% block title %}Contact Requests{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Contact Requests</h1>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped align-middle">
                <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">User</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Message</th>
                    <th scope="col">Status</th>
                    <th scope="col">Date</th>
                    <th scope="col">Delete</th>
                </tr>
                </thead>
                <tbody>
                {% for req in requests %}
                    <tr>
                        <td>{{ req.id }}</td>
                        <td>{{ req.user.email }}</td>
                        <td>{{ req.subject }}</td>
                        <td>{{ req.message }}</td>
                        <td>
                            <span class="badge
                                {% if req.status == 'nieuw' %}
                                    bg-warning text-dark
                                {% elseif req.status == 'beantwoord' %}
                                    bg-success
                                {% else %}
                                    bg-secondary
                                {% endif %}
                            ">
                                {{ req.status|capitalize }}
                            </span>
                        </td>
                        <td>{{ req.createdAt|date('Y-m-d H:i') }}</td>
                        <td>
                            <form method="post" action="{{ path('contact_request_delete', { id: req.id }) }}" onsubmit="return confirm('Are you sure you want to delete this request?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-request-' ~ req.id) }}">
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">No contact requests found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
